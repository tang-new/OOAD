{
  "name": "rbac-web",
  "private": true,
  "version": "1.0.0",
  "description": "统一授权中心前端（Vue 3 + TypeScript），界面设计见 docs/requirements.adoc",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "axios": "1.21.1",
    "pinia": "2.3.1",
    "vue": "3.5.45",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/coverage-v8": "4.1.12",
    "@vue/test-utils": "2.5.1",
    "jsdom": "25.0.1",
    "mysql2": "^3.24.6",
    "typescript": "5.7.2",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.14"
  }
}
