# The prepared build context contains only pinned backend/api/prototype/LICENSE + reviewed overlay.
# First run tools/prepare-course.sh --build; no build dependencies or rosters enter runtime.
FROM eclipse-temurin:21-jre
WORKDIR /app
COPY backend/target/course-project-backend-0.0.1-SNAPSHOT.jar app.jar
COPY LICENSE /app/LICENSE.upstream
USER 10001:10001
EXPOSE 8080
ENV SPRING_PROFILES_ACTIVE=integration
ENTRYPOINT ["java","-jar","/app/app.jar"]
