     @Bean
     public UnifiedAuditClient unifiedAuditClient(
             @Value("${app.identity.base-url}")
-            String baseUrl
+            String baseUrl,
+            @Value("${app.integration.service-key:}")
+            String serviceKey,
+            org.springframework.core.env.Environment environment
     ) {
         RestClient restClient = restClientFactory.create(baseUrl);
+        if (environment.matchesProfiles("integration")) {
+            if (serviceKey.isBlank()) {
+                throw new IllegalArgumentException("课程集成必须配置审计服务密钥。");
+            }
+            restClient = restClient.mutate().defaultHeader("X-Audit-Service-Key", serviceKey).build();
+        }
         return HttpServiceProxyFactory.builderFor(RestClientAdapter.create(restClient))
                 .build()
                 .createClient(UnifiedAuditClient.class);
