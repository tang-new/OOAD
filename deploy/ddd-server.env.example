# Copy to .runtime/ddd-server/server.env and edit for the deployment host.
# The default listen address works behind the server's existing HTTPS reverse proxy.
DDD_SERVER_ORIGIN=https://rbac.example.edu
DDD_SERVER_BIND_ADDRESS=127.0.0.1
DDD_SERVER_HTTP_PORT=8083

# Existing MySQL on a separate server. Store its user's password in center-db-password.
DDD_SERVER_DB_URL=jdbc:mysql://10.20.0.12:3306/rbac_center?serverTimezone=UTC&sslMode=REQUIRED
DDD_SERVER_DB_USER=rbac_center

# Existing Redis reachable from the DDD container.
DDD_SERVER_REDIS_HOST=10.20.0.13
DDD_SERVER_REDIS_PORT=6379
# DDD_SERVER_REDIS_PASSWORD=
# DDD_SERVER_REDIS_TLS=true

# Private VPN address of the computer running the original course backend.
COURSE_UPSTREAM=http://10.20.0.24:8084

# Optional absolute secret path or registry image tag.
# DDD_SERVER_SECRETS_DIR=/srv/ooad/secrets
# DDD_SERVER_IMAGE=registry.example.edu/ooad/rbac-ddd:release-tag
