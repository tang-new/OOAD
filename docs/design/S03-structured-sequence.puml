@startuml
hide footbox
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 14
skinparam ParticipantPadding 24
skinparam BoxPadding 12
skinparam sequenceMessageAlign left
skinparam maxMessageSize 100
title S03-structured-sequence — source snapshot (not a runtime trace)
participant "obj: 调用者" as obj
participant "ctl: ManagementController" as ctl
participant "svc: ManagementService" as svc
participant "auth: AuthorizationService" as auth
participant "model: Store" as model
activate obj
obj -> ctl: 1. getUserEffectivePermissions(actor, user, system)
activate ctl
ctl -> svc: 2. effectiveUser(actor, user, system)
activate svc
svc -> auth: 3. snapshot(userId, system)
activate auth
auth -> auth: 4. require(User.class, userId)
activate auth
deactivate auth
auth -> auth: 5. system(system)
activate auth
deactivate auth
auth -> auth: 6. active(user, softwareSystem)
activate auth
deactivate auth
alt actual transaction active
auth -> auth: 7. direct(userId, systemId)
activate auth
deactivate auth
auth -> auth: 8. calculate(directIds, systemId)
activate auth
note over auth
calculate checks system enabled, loads roles/edges/permissions/grants
end note
auth -> model: 9. where(Role.class, system predicate)
activate model
deactivate model
loop each valid direct root
auth -> auth: 10. walk(root, roles, edges, grants, path, effective, permissions, sources)
activate auth
deactivate auth
end
deactivate auth
note over auth
No cache reads OR writes in transaction.
end note
else nontransactional read
loop at most 3 attempts
auth -> auth: 11. version()
activate auth
deactivate auth
note over auth
namespace:authz:system:user:version → l1.get;
miss → redis.opsForValue().get; Redis exception falls back to DB.
end note
alt no cached result
auth -> auth: 12. direct(userId, systemId)
activate auth
deactivate auth
auth -> auth: 13. calculate(directIds, systemId)
activate auth
note over auth
calculate checks system enabled, loads roles/edges/permissions/grants
end note
auth -> model: 14. where(Role.class, system predicate)
activate model
deactivate model
loop each valid direct root
auth -> auth: 15. walk(root, roles, edges, grants, path, effective, permissions, sources)
activate auth
deactivate auth
end
deactivate auth
else cached result
note over auth
no recalculation
end note
end
auth -> auth: 16. version()
activate auth
deactivate auth
alt version changed
note over auth
continue, no publishing
end note
else unchanged
note over auth
l1.put and Redis set, then return result
end note
end
end
note over auth
exhausted attempts → 503 AUTHORIZATION_UNAVAILABLE
end note
end
note over auth
namespace is configured by rbac.cache.namespace, not hardcoded.
System disabled within calculate yields empty; snapshot validates active user/system first.
end note
note over auth
Disabled intermediate role cuts that path; diamond permission id dedup
preserves independent source paths. No direct roles → empty permissions.
end note
deactivate auth
deactivate svc
deactivate ctl
deactivate obj
@enduml