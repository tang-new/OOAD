@startuml
!pragma teoz true
hide footbox
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 14
skinparam ParticipantPadding 24
skinparam BoxPadding 12
skinparam sequenceMessageAlign left
skinparam maxMessageSize 160
title S03-ddd-sequence — source snapshot (not a runtime trace)
participant "obj: 调用者" as obj
participant "ctl: DirectoryController" as ctl
participant "«MetaClass»\n: RestSupport" as rest
participant "svc: DirectoryApplicationService" as svc
participant "auth: AuthorizationApplicationService" as auth
participant "model: AuthorizationPolicy" as model
participant "graph: RoleHierarchy" as graph
participant "reads: AuthorizationReadTransaction" as reads
participant "repo: AuthorizationRepository" as repo
participant "cache: EffectiveCache" as cache
activate obj
obj -> ctl: 1. effective(bearer, id, system)
activate ctl
ctl -> svc: 2. effective(principal, id, system)
activate svc
svc -> svc: 3. actor(principal, rbac:user:view, false)
activate svc
deactivate svc
svc -> repo: 4. systemEnabled(system)
activate repo
break unknown system
repo -->> obj: DomainException 404 SYSTEM_NOT_FOUND
end
repo -->> svc: system status
deactivate repo
svc -> svc: 5. managedUser(actor, id)
activate svc
deactivate svc
note over svc
Resolve the system before loading the target user and checking department scope.
end note
svc -> auth: 6. effective(userId, system)
activate auth
alt no outer read-only transaction (S03 HTTP takes this path)
auth -> auth: 7. stableEffective(userId, system)
activate auth
loop until the version is stable or three attempts are used
auth -> repo: 8. version()
activate repo
repo -->> auth: initial version
deactivate repo
auth -> repo: 9. systemEnabled(system)
activate repo
repo -->> auth: system status
deactivate repo
break target system disabled
auth -->> svc: DomainException 401 SYSTEM_DISABLED
note over svc
Catch this target-side error and use empty Effective.
end note
end
auth -> repo: 10. identity(userId)
activate repo
repo -->> auth: target identity
deactivate repo
break target user missing
auth -->> obj: DomainException 404 USER_NOT_FOUND
end
alt target user inactive
note over auth
Use empty Effective.
end note
else target user active
opt no active transaction
auth -> cache: 11. get(system, userId, version)
activate cache
cache -->> auth: cached Effective or null
deactivate cache
end
opt no usable cached result
auth -> repo: 12. assignments(userId, system)
activate repo
repo -->> auth: direct role IDs
deactivate repo
auth -> repo: 13. hierarchy(system)
activate repo
repo -->> auth: role graph
deactivate repo
auth -> repo: 14. permissions(system)
activate repo
repo -->> auth: permission catalog
deactivate repo
auth -> model: 15. calculate(system, directIds, graph, permissions)
activate model
model -> graph: 16. paths(safeDirect)
activate graph
loop each direct role
graph -> graph: 17. visit(id, new ArrayList<>(), result)
activate graph
deactivate graph
note right of graph
Skip disabled roles and preserve distinct paths.
end note
end
graph -->> model: role paths
deactivate graph
model -->> auth: calculated Effective
deactivate model
end
end
auth -> repo: 18. version()
activate repo
repo -->> auth: version before cache write
deactivate repo
opt version unchanged since the initial read
opt target user active and no active transaction
auth -> cache: 19. put(system, userId, version, result)
activate cache
deactivate cache
note right of cache
Cache the candidate for this version.
end note
end
auth -> repo: 20. version()
activate repo
repo -->> auth: final version
deactivate repo
end
note over auth,repo
A version change before or after writing starts the next attempt.
An unchanged final version ends the loop with the candidate result.
end note
end
break three attempts exhausted
auth -->> obj: DomainException 503 AUTHORIZATION_UNSTABLE
end
auth -->> auth: stable Effective
deactivate auth
else read-only outer transaction (other callers)
auth -> reads: 21. fresh(query callback)
activate reads
reads -> auth: 22. stableEffective(userId, system)
activate auth
note over auth,reads
Same retry algorithm in REQUIRES_NEW / READ_COMMITTED / readOnly.
Clear the JPA context at the start of each attempt and skip all cache access.
end note
auth -->> reads: stable Effective
deactivate auth
reads -->> auth: stable Effective
deactivate reads
end
opt stable Effective returned
auth -->> svc: stable Effective
end
deactivate auth
opt stable result or caught SYSTEM_DISABLED
svc -->> ctl: Effective (empty for disabled system)
deactivate svc
ctl -> rest: 23. effective(effective)
activate rest
rest -->> ctl: effective permissions
deactivate rest
ctl -> rest: 24. ok(effective permissions)
activate rest
rest -->> ctl: response body
deactivate rest
ctl -->> obj: HTTP 200 with effective permissions
end
deactivate ctl
deactivate obj
@enduml