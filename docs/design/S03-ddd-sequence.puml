@startuml
hide footbox
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 14
skinparam ParticipantPadding 24
skinparam BoxPadding 12
skinparam sequenceMessageAlign left
skinparam maxMessageSize 100
title S03-ddd-sequence — source snapshot (not a runtime trace)
participant "obj: 调用者" as obj
participant "ctl: DirectoryController" as ctl
participant "svc: DirectoryApplicationService" as svc
participant "auth: AuthorizationApplicationService" as auth
participant "model: AuthorizationPolicy" as model
participant "graph: RoleHierarchy" as graph
participant "reads: AuthorizationReadTransaction" as reads
participant "repo: AuthorizationRepository" as repo
participant "cache: EffectiveCache" as cache
activate obj
obj -> ctl: 1. effective(bearer, id, system)
activate ctl
ctl -> svc: 2. effective(principal, id, system)
activate svc
svc -> auth: 3. effective(userId, system)
activate auth
alt actual outer transaction is read-only
auth -> reads: 4. fresh(query callback)
activate reads
reads -> auth: 5. stableEffective(userId, system)
activate auth
deactivate auth
note over reads,repo
Supplier.get callback runs inside REQUIRES_NEW / READ_COMMITTED / readOnly.
Same stableEffective loop as expanded below; each retry freshenRead clears JPA context.
end note
deactivate reads
else no outer read-only transaction
auth -> auth: 6. stableEffective(userId, system)
activate auth
loop at most 3 attempts
auth -> repo: 7. version()
activate repo
deactivate repo
auth -> repo: 8. systemEnabled(system)
activate repo
deactivate repo
auth -> repo: 9. identity(userId)
activate repo
deactivate repo
alt inactive target
note over auth
empty Effective; no stale user permissions
end note
else ACTIVE and no actual transaction
auth -> cache: 10. get(system, userId, version)
activate cache
deactivate cache
else active write transaction
note over auth
bypass get AND put
end note
end
alt result still null
auth -> repo: 11. assignments(userId, system)
activate repo
deactivate repo
auth -> repo: 12. hierarchy(system)
activate repo
deactivate repo
auth -> repo: 13. permissions(system)
activate repo
deactivate repo
auth -> model: 14. calculate(system, directIds, graph, permissions)
activate model
model -> graph: 15. paths(safeDirect)
activate graph
loop each direct role
graph -> graph: 16. visit(id, new ArrayList<>(), result)
activate graph
deactivate graph
end
deactivate graph
deactivate model
end
auth -> repo: 17. version()
activate repo
deactivate repo
alt version changed
note over auth
continue; never publish mixed snapshot
end note
else version unchanged
opt ACTIVE target and no actual transaction
auth -> cache: 18. put(system, userId, version, result)
activate cache
deactivate cache
end
auth -> repo: 19. version()
activate repo
deactivate repo
note over auth
final version equal → return; changed again → next attempt
end note
end
end
alt all attempts unstable
auth --> obj: DomainException 503 AUTHORIZATION_UNSTABLE
else stable
note over auth
valid cached OR calculated result
end note
end
deactivate auth
end
note over auth
Disabled intermediate role cuts that path; diamond permission id dedup
preserves independent source paths. No direct roles → empty permissions.
end note
deactivate auth
deactivate svc
deactivate ctl
deactivate obj
@enduml